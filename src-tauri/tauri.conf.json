{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "AI 酒馆",
  "version": "0.1.0",
  "identifier": "com.airoleplay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 酒馆 — 角色扮演对话",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark",
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "freezePrototype": true
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 AI Roleplay",
    "category": "Productivity",
    "shortDescription": "AI 角色扮演与多模型对话平台",
    "longDescription": "基于 SillyTavern 架构的 AI 角色扮演聊天应用，支持多模型对话、角色卡管理、世界书与本地文件存储。",
    "publisher": "AI Roleplay",
    "homepage": "",
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": null,
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhuweib-design/ai-roleplay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MkY3NkZCMUYxNDIyNkYKUldSdkloUWYrM1l2UjBFRGdGblp6NlB6aVZiZFpMMjI5SWRlVEsyVlIyNlQvUU1nc2FvU3JxdzQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
